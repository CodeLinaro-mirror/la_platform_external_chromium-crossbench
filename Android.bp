package {
    default_applicable_licenses: ["external_crossbench_license"],
}

license {
    name: "external_crossbench_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

java_genrule_host {
    name: "chromium_crossbench_zip",
    tools: [
        "soong_zip",
    ],
    srcs: [
        "*.ini",
        "*.py",
        "chrome-extension-replay/**/*",
        "config/**/*",
        "crossbench/**/*",
        "protoc/**/*",
        "tests/**/*",
    ],
    out: ["chromium-crossbench.zip"],
    cmd: "$(location soong_zip) -o $(out) -C external -D external",
}
