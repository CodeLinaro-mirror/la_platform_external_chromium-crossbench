{
  "probes": {
    "perfetto": {
      "textproto": "./perfetto_trace_config.txtpb"
    }
    "trace_processor": {
      "queries": [
        {
          "name": "browser_window_first_paint"
          "sql":
            '''
            SELECT
              dur / 1e6 AS duration_ms
            FROM slice
            WHERE name = 'Startup.BrowserWindow.FirstPaint'
            LIMIT 1
            '''
        }
      ]
    }
  }
}
