{
  type: wpr
  url: gs://chrome-partner-telemetry/loading_benchmark/archive_tablet_deterministic.wprgo
  persist_server: true
  run_on_device: true
  // Injecting deterministic.js in some stories causes errors (see
  // crbug.com/428945380). archive_tablet_deterministic is a prebuilt archive
  // which skips injection for the problematic stories, and thus fixes the
  // issue.
  skip_deterministic_script_injection: true
  response_transformations_file: webpagereplay_script_injections_tablet.json
}
