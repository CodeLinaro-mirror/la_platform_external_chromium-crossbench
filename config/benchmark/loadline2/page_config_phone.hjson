{
  pages: {
    amazon_product: [
      {
        action: js
        script:
          '''
          performance.mark('LoadLine2/phone/amazon_product_start');
          window.location.href = 'https://www.amazon.co.uk/NIVEA-Suncream-Spray-Protect-Moisture/dp/B001B0OJXM';
          '''
      }
      {
        action: wait_for_condition
        condition:
          '''
          return performance.getEntriesByName('LoadLine2/amazon_product/menu_shown').length > 0
              && performance.getEntriesByName('LoadLine2/amazon_product/buy_shown').length > 0
          '''
        timeout: 10s
      }
      {
        action: wait
        duration: 100ms
      }
      {
        action: js
        script: performance.mark('LoadLine2/phone/amazon_product_finish')
      }
    ]
    cnn_article: [
      {
        action: js
        script:
          '''
          performance.mark('LoadLine2/phone/cnn_article_start');
          window.location.href = 'https://edition.cnn.com/2024/04/21/china/china-spy-agency-public-profile-intl-hnk/index.html';
          '''
      }
      {
        action: wait_for_condition
        condition:
          '''
          return performance.getEntriesByName('LoadLine2/cnn_article/menu_shown').length > 0
              && performance.getEntriesByName('LoadLine2/cnn_article/headline_shown').length > 0
          '''
        timeout: 10s
      }
      {
        action: wait
        duration: 100ms
      }
      {
        action: js
        script: performance.mark('LoadLine2/phone/cnn_article_finish')
      }
    ]
    wikipedia_article: [
      {
        action: js
        script:
          '''
          performance.mark('LoadLine2/phone/wikipedia_article_start');
          window.location.href = 'https://en.m.wikipedia.org/wiki/Taylor_Swift';
          '''
      }
      {
        action: wait_for_condition
        condition:
          '''
          return performance.getEntriesByName('LoadLine2/wikipedia_article/language_shown').length > 0
              && performance.getEntriesByName('LoadLine2/wikipedia_article/image_shown').length > 0
          '''
        timeout: 10s
      }
      {
        action: wait
        duration: 100ms
      }
      {
        action: js
        script: performance.mark('LoadLine2/phone/wikipedia_article_finish')
      }
    ]
    globo_homepage: [
      {
        action: js
        script:
          '''
          performance.mark('LoadLine2/phone/globo_homepage_start');
          window.location.href = 'https://www.globo.com/';
          '''
      }
      {
        action: wait_for_condition
        condition:
          '''
          return performance.getEntriesByName('LoadLine2/globo_homepage/cookie_banner_gone').length > 0
              && performance.getEntriesByName('LoadLine2/globo_homepage/headline_shown').length > 0
          '''
        timeout: 10s
      }
      {
        action: wait
        duration: 100ms
      }
      {
        action: js
        script: performance.mark('LoadLine2/phone/globo_homepage_finish')
      }
    ]
    google_search_result: [
      {
        action: js
        script:
          '''
          performance.mark('LoadLine2/phone/google_search_result_start');
          window.location.href = 'https://www.google.com/search?q=cats';
          '''
      }
      {
        action: wait_for_condition
        condition:
          '''
          return performance.getEntriesByName('LoadLine2/google_search_result/menu_shown').length > 0
              && performance.getEntriesByName('LoadLine2/google_search_result/overview_shown').length > 0
          '''
        timeout: 10s
      }
      {
        action: wait
        duration: 100ms
      }
      {
        action: js
        script: performance.mark('LoadLine2/phone/google_search_result_finish')
      }
    ]
  }
}
